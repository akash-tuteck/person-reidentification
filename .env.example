APP_NAME="Person Re-Identification & Access Control API"
APP_ENV="development"
DEBUG=False

# Auth is off by default. Set AUTH_ENABLED=true to require the API key below.
AUTH_ENABLED=false
# API key (required when AUTH_ENABLED=true, header X-API-Key). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY="change-me-to-a-long-random-string"

# Database connection:
# Default SQLite for local Edge / NVIDIA Jetson (zero extra RAM)
# For central PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/access_control_db
DATABASE_URL="sqlite:///./data/production.db"

# Image and upload limits
MAX_FILE_SIZE=10485760
MAX_IMAGE_DIMENSION=1024
MAX_IMAGE_PIXELS=25000000

# File storage directories
GALLERY_DIR="./data/gallery"
EVIDENCE_DIR="./data/evidence"

# Person detector (yolov8n is fastest but misses people in real CCTV)
YOLO_MODEL="yolov8m.pt"
YOLO_CONF=0.25
YOLO_IMGSZ=640
TRACK_MATCH_THRESH=0.95
BODY_MATCH_THRESHOLD=0.65
# true on cameras where faces are visible (door cameras); false for overhead cameras
FACE_VETO_BODY=false
